# Copy to .env and fill in every value. Git ignores .env.

# Supabase session pooler URL (port 5432)
DATABASE_URL=
# The same session pooler URL, used by the Prisma CLI
DIRECT_URL=
# DATABASE_SCHEMA is set in .env.test only

# Long random string that signs the login session
JWT_SECRET=
# http://localhost:3000 when running on your own computer
APP_ORIGIN=

# Web Push key pair for reminders, from npx web-push generate-vapid-keys --json
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# mailto: followed by a real email address
VAPID_SUBJECT=

# Long random string sent with each call to the reminder check
CRON_SECRET=

# Fictional demo accounts made by the seed script
SEED_PATIENT_EMAIL=
SEED_PATIENT_PASSWORD=
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
