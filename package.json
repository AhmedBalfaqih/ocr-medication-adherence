{
  "name": "ocr-medication-adherence",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "26.x"
  },
  "scripts": {
    "dev": "next dev",
    "build": "prisma migrate deploy && next build",
    "start": "next start",
    "lint": "eslint .",
    "format": "prettier --write --no-error-on-unmatched-pattern src test prisma scripts docs package.json jsconfig.json components.json next.config.mjs postcss.config.mjs eslint.config.mjs prisma.config.js vitest.config.js .prettierrc.json README.md",
    "test": "vitest run",
    "db:seed": "node prisma/seed.js",
    "db:check": "node scripts/db-check.js",
    "postinstall": "prisma generate && node scripts/copy-tesseract.js"
  },
  "dependencies": {
    "@base-ui/react": "1.9.0",
    "@hookform/resolvers": "7.0.1",
    "@hugeicons/core-free-icons": "4.4.0",
    "@hugeicons/react": "1.1.10",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "@tesseract.js-data/eng": "1.0.0",
    "bcrypt": "6.0.0",
    "class-variance-authority": "0.7.1",
    "cn": "0.5.2",
    "dotenv": "18.0.9",
    "jose": "6.2.15",
    "next": "16.4.4",
    "pg": "8.23.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-hook-form": "7.91.0",
    "shadcn": "4.23.0",
    "tesseract.js": "7.0.0",
    "tw-animate-css": "1.4.0",
    "web-push": "3.6.7",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.4",
    "prettier": "3.9.10",
    "prisma": "7.10.1",
    "tailwindcss": "4.3.3",
    "vitest": "5.0.5"
  }
}
