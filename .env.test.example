# Copy to .env.test and fill in every value. The tests use the test schema only.

# The same Supabase session pooler URL as in .env (port 5432)
DATABASE_URL=
# The same URL again, ending with ?schema=test
DIRECT_URL=
# Keeps the app's database client inside the test schema
DATABASE_SCHEMA=test

# Long random string, different from the one in .env
JWT_SECRET=
# http://localhost:3000
APP_ORIGIN=

# A Web Push key pair from npx web-push generate-vapid-keys --json, not the one in .env
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# mailto: followed by a real email address
VAPID_SUBJECT=

# Long random string, different from the one in .env
CRON_SECRET=

# Fictional demo accounts made by the seed script
SEED_PATIENT_EMAIL=
SEED_PATIENT_PASSWORD=
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
